#!/bin/bash
# 此脚本为示例部署脚本，请拷贝为 deploy.sh 并根据实际情况修改后使用
# 请勿提交实际的 deploy.sh 文件到版本控制或泄露敏感信息

set -e

echo "[*] 开始部署！"

# ===== 配置 =====
# 前后端端口配置
FRONTEND_PORT=3500
BACKEND_PORT=8500

# 程序配置
PROGRAM_CMD="/var/www/BeikeStartups/BeikeStartups/backend/BeikeStartups" # 此行按需修改
PROGRAM_MATCH="/BeikeStartups/backend/BeikeStartups" # 此行按需修改

FRONTEND_CMD="pnpm start -p $FRONTEND_PORT"
FRONTEND_MATCH="pnpm start -p $FRONTEND_PORT"

BACKEND_DIR="backend"
FRONTEND_DIR="frontend"

BACKEND_LOG="backend.log"
FRONTEND_LOG="frontend.log"

# 数据库配置
export DB_HOST="localhost"
export DB_PORT=5432
export DB_USER="your_user" # 此行必须修改
export DB_PASSWORD="your_db_password" # 此行必须修改
export DB_NAME="beikestartups_db"

# 后端配置
export JWT_SECRET="your_jwt_secret_key" # 此行必须修改
export CORS_ORIGIN="https://domain.exmple.com" # 此行必须修改，入站访问地址

# ===== 校验 =====
# 检查数据库环境变量是否是默认值
if [ "$DB_USER" = "your_user" ] || [ "$DB_PASSWORD" = "your_db_password" ]; then
    echo "[!] 数据库配置似乎未修改，请检查脚本的环境变量设置！"
    exit 1
fi
if [ "$JWT_SECRET" = "your_jwt_secret_key" ]; then
    echo "[!] JWT_SECRET 似乎未修改，请检查脚本的环境变量设置！"
    exit 1
fi
if [ "$CORS_ORIGIN" = "https://domain.exmple.com" ]; then
    echo "[!] CORS_ORIGIN 似乎未修改，请检查脚本的环境变量设置！"
    exit 1
fi

echo "[*] 后端将在端口 $PORT 上运行，前端将在端口 $FRONTEND_PORT 上运行"
echo ""

# ===== 通用函数 =====
kill_process() {
    local MATCH=$1
    local NAME=$2

    PIDS=$(pgrep -f "$MATCH" || true)
    if [ -n "$PIDS" ]; then
        echo "[*] 发现 $NAME 进程，正在终止: $PIDS"
        kill $PIDS
        sleep 2
        kill -9 $PIDS 2>/dev/null || true
    else
        echo "[*] 未发现存活的 $NAME 进程"
    fi
}

# ===== 清理旧进程 =====
kill_process "$PROGRAM_MATCH" "backend"
kill_process "$FRONTEND_MATCH" "frontend"

# ===== 启动 backend =====
echo "[*] 构建 backend..."
cd "$BACKEND_DIR"
go version
go env -w GOPROXY=https://goproxy.cn,direct
go mod tidy
go build

export PORT=$BACKEND_PORT
export GIN_MODE="release"

echo "[*] 构建完毕，正在启动 backend..."
nohup $PROGRAM_CMD > "../$BACKEND_LOG" 2>&1 &

cd ..

# ===== 启动 frontend =====
echo "[*] 构建 frontend..."
cd "$FRONTEND_DIR"
pnpm install
pnpm build

export NEXT_PUBLIC_API_URL="http://localhost:$BACKEND_PORT"

echo "[*] 构建完毕，正在启动 frontend..."
nohup $FRONTEND_CMD > "../$FRONTEND_LOG" 2>&1 &

cd ..

echo "[*] 所有服务启动完成"
echo ""

# ===== 检验 =====

echo "[*] 当前服务器的内存状态："
free -h

echo "[*] 等待数秒后检查部署状态..."
sleep 5

curl --silent --fail "http://localhost:$BACKEND_PORT" > /dev/null && echo "[*] 后端检查通过！" || echo "[!] 后端检查失败！"
curl --silent --fail "http://localhost:$FRONTEND_PORT" > /dev/null && echo "[*] 前端检查通过！" || echo "[!] 前端检查失败！"

echo "[*] 部署结束！"
